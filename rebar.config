{minimum_otp_vsn, "22"}.

{erl_opts, [{d, 'NOTEST'},
            warn_obsolete_guard,
            warn_unused_import,
            warnings_as_errors,
            warn_shadow_vars,
            warn_export_vars,
            warn_export_all]}.

{xref_checks, [undefined_function_calls]}.
{cover_enabled, true}.

{plugins, [pc]}.

{provider_hooks, [
    {pre, [
        {compile, {pc, compile}},
        {clean, {pc, clean}}
    ]}
]}.

{port_specs, [
    {"priv/leo_mcerl.so", ["c_src/*.c"]}
]}.

{port_env, [
    {"CFLAGS", "$CFLAGS -fPIC -g -O2 -Ic_src/libcutil/src"},
    {"LDFLAGS", "$LDFLAGS c_src/libcutil/build/src/libcutil.a"}
]}.

{pre_hooks, [
    {compile, "c_src/build_deps.sh"}
]}.

{post_hooks, [
    {clean, "c_src/build_deps.sh clean"}
]}.
